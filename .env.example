# Personal access token: YNAB > Account Settings > Developer Settings
YNAB_API_KEY=

# Optional. Find it in the URL of your budget (app.ynab.com/<budget-id>/budget).
# Defaults to "last-used".
YNAB_BUDGET_ID=

# Optional. Comma-separated rule names to skip (see "name:" in rules.yaml).
# GitHub Actions reads the same setting from the YNAB_DISABLED_RULES repo variable.
YNAB_DISABLED_RULES=

# Optional email digests (see README). Only sent when SMTP_USER, SMTP_PASSWORD and
# NOTIFY_EMAIL_TO are all set.
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
# Optional: who gets the monthly report (defaults to NOTIFY_EMAIL_TO).
# REPORT_EMAIL_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# NOTIFY_EMAIL_FROM=
